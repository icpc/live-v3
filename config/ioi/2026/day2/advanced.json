[
    {
        "type": "overrideScoreboardSettings",
        "showTeamsWithoutSubmissions": false
    },
    {
        "type": "overrideOrganizations",
        "rules": {
            "UK":{"customFields":{"emoji":"🇬🇧"}},
            "IOI1":{"customFields":{"emoji":"\uE000"}},
            "IOI2":{"customFields":{"emoji":"\uE000"}},
            "IOI3":{"customFields":{"emoji":"\uE000"}},
            "IOI4":{"customFields":{"emoji":"\uE000"}},
        }

    },
    {
        "type": "overrideTeamTemplate",
        "displayName": "{org.customFields.emoji} {first_name} {last_name}",
        "extraGroups": ["{org.id}"],
        "medias": {
            "screen": {"type": "Object", "url": "/api/overlay/svgAchievement/ioi-pasportu.svg?teamId={team.id}"},
            "photo": {"type": "Image", "url": "https://ranking.ioi2026.uz/faces/{team.id}.jpg", "vertical": true}
        }
    },
    {
        "type": "overrideTeams",
        "rules": {
            "uzb5": {"isOutOfContest": true},
            "uzb6": {"isOutOfContest": true},
            "uzb7": {"isOutOfContest": true},
            "uzb8": {"isOutOfContest": true}
        }
    },
    {
        "type": "overrideProblems",
        "rules": {
            "ballmachine": {
                "displayName": "A1",
                "color": "#85461E"
            },
            "monuments": {
                "displayName": "B1",
                "color": "#f032e6"
            },
            "tiling": {
                "displayName": "C1",
                "color": "#42d4f4"
            },
            "classroom": {
                "displayName": "A2",
                "color": "#85461E"
            },
            "magiccity": {
                "displayName": "B2",
                "color": "#f032e6"
            },
            "partition": {
                "displayName": "C2",
                "color": "#42d4f4"
            }

        }
    },
    {
        "type": "addMedals",
        "gold": 32,
        "silver": 63,
        "bronze": 92
    },
    {
        "type": "overrideQueue",
        "maxQueueSize": 17,
        "maxUntestedRun": 5
    }
