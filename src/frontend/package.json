{
    "name": "icpc-live-v3",
    "version": "3.1.0",
    "private": true,
    "scripts": {
        "": "TODO: change to use pnpm",
        "buildOverlay": "npm run build -w overlay",
        "buildAdminOverlay": "npm run build -w admin-overlay",
        "buildAdminConverter": "npm run build -w admin-converter",
        "buildLocatorAdmin": "npm run build -w locator",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "npm run lint -w overlay && npm run lint -w admin-overlay && npm run lint -w admin-configuration && npm run lint -w admin-converter && npm run lint -w admin-home-page",
        "test": "npm run test -w tests",
        "install-browsers": "npm run install-browsers -w tests",
        "overlayConfigSchema": "npm run schema:config -w overlay"
    },
    "workspaces": [
        "overlay",
        "admin-overlay",
        "admin-configuration",
        "admin-converter",
        "admin-home-page",
        "locator",
        "common",
        "tests"
    ],
    "engines": {
        "node": ">=20",
        "npm": ">=10.2.4"
    },
    "devDependencies": {
        "prettier": "^3.6.2"
    }
}
